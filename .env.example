# ==============================================================================
# TMDB API v3 (Verplicht, Server-only)
# ==============================================================================
# Persoonlijke API-sleutel voor The Movie Database API v3 (blijft strikt server-side)
TMDB_API_KEY=your_tmdb_api_v3_key_here

# ==============================================================================
# SUPABASE SSR & AUTHENTICATIE (Verplicht)
# ==============================================================================
# Project-URL vanuit het Supabase Dashboard (Project Settings > Data API)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co

# Publieke Anon / Publishable key (beveiligd via PostgreSQL Row Level Security)
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key_here

# ==============================================================================
# WEBSITE ORIGIN & VERCEL REDIRECTS (Optioneel)
# ==============================================================================
# Basis-URL voor PKCE e-mailcallbacks (/auth/callback) en redirects.
# Laat lokaal op http://localhost:3000; op Vercel valt getSiteUrl() automatisch
# terug op reverse-proxy headers, VERCEL_PROJECT_PRODUCTION_URL of VERCEL_URL.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
